<Window x:Class="Bellboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="960" Height="700" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Border Margin="20" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sections -->
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" CornerRadius="15,0,0,15" Padding="10,18,10,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="10" LineHeight="17" TextWrapping="Wrap"
                               Text="Changes preview live. Save to keep them."/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,14">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FgStrong}"/>
                        </StackPanel>
                        <StackPanel x:Name="Nav"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <!-- Search + close -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="28,12,14,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Close (Esc)" Click="Cancel_Click"/>
                        <Border x:Name="SearchFrame" Background="{StaticResource InputBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="9" Height="34"
                                MaxWidth="360" HorizontalAlignment="Left" Width="360" Padding="11,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <Grid>
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgStrong}" CaretBrush="{StaticResource FgStrong}"
                                             FontSize="13" VerticalContentAlignment="Center" TextChanged="Search_TextChanged"
                                             GotKeyboardFocus="Search_Focus" LostKeyboardFocus="Search_Focus"/>
                                    <TextBlock x:Name="SearchPlaceholder" Text="Search settings" FontSize="13" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="20,12,16,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SidebarButton}" Click="OpenFile_Click" ToolTip="Edit the settings file directly">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open config.json" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="Dirty" DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Hidden" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Unsaved changes" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource DialogButton}" Content="Cancel" Click="Cancel_Click"/>
                            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0" Click="Save_Click" IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,0,24,0" ScrollChanged="Scroller_ScrollChanged">
                    <StackPanel x:Name="Sections" Margin="0,0,4,40"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
