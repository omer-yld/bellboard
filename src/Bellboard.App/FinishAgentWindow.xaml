<Window x:Class="Bellboard.FinishAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="640" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterOwner">
    <Border Margin="20" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="16" Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Finish agent" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FgStrong}" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TaskText" FontSize="13" Foreground="{StaticResource FgStrong}" Margin="0,12,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="BranchText" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,12,0,0">
                <TextBlock x:Name="SummaryText" FontSize="12.5" Foreground="{StaticResource Fg}" TextWrapping="Wrap" Text="Checking the branch…"/>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button x:Name="DiscardButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="Discard…" Click="Discard_Click"/>
                <Button x:Name="MergeButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Merge" Click="Merge_Click" Margin="8,0,0,0"/>
                <Button x:Name="PrButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Pull request" Click="Pr_Click" Margin="8,0,0,0"
                        ToolTip="Push the branch and open a pull request with gh"/>
                <Button x:Name="KeepButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Keep branch" Click="Keep_Click" Margin="8,0,0,0"
                        ToolTip="Close the workspace; leave the branch and worktree"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Cancel" Click="Cancel_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
