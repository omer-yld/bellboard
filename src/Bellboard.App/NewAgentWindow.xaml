<Window x:Class="Bellboard.NewAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="700" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Border Margin="20" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <DockPanel>
            <!-- Head -->
            <Grid DockPanel.Dock="Top" Margin="24,20,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentTint}" BorderBrush="#4DF5A524" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                    <TextBlock Text="New agent" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FgStrong}"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Faint}" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="19" MaxWidth="470" HorizontalAlignment="Left"
                               Text="Hands a task to a coding agent on its own branch and worktree, then opens a workspace so you can watch, reply or take over."/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" VerticalAlignment="Top" ToolTip="Close (Esc)" Click="Cancel_Click"/>
            </Grid>

            <!-- Foot -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="24,12,16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.Foreground="{StaticResource Faint}">
                        <Border Style="{StaticResource Kbd}" Margin="0"><TextBlock Text="Ctrl" Style="{StaticResource KbdText}"/></Border>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="↵" Style="{StaticResource KbdText}"/></Border>
                        <TextBlock Text=" start · " VerticalAlignment="Center" Margin="3,0,3,0"/>
                        <Border Style="{StaticResource Kbd}" Margin="0"><TextBlock Text="Esc" Style="{StaticResource KbdText}"/></Border>
                        <TextBlock Text=" cancel" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource DialogButton}" Content="Cancel" Click="Cancel_Click"/>
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Start_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StartGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StartText" Text="Start agent" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body -->
            <StackPanel Margin="24,14,24,20">
                <!-- Where it runs, and on which repo -->
                <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="12" Padding="12,8,9,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Repo" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="RepoButton" Style="{StaticResource RepoButton}" Click="Repo_Click" ToolTip="Choose another repository" MaxWidth="300">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Faint}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RepoText" TextTrimming="CharacterEllipsis" MaxWidth="230" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Faint}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Runs in" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Style="{StaticResource SegmentTrack}">
                                <ItemsControl x:Name="EnvList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="env" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         FontSize="12" Checked="Env_Checked"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Task -->
                <DockPanel Margin="0,18,0,7">
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                    <TextBlock Text="Task" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                </DockPanel>
                <Border x:Name="TaskFrame" Background="{StaticResource InputBg}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="TaskBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgStrong}" CaretBrush="{StaticResource FgStrong}"
                                     SelectionBrush="{StaticResource Accent}" FontSize="13.5" Padding="11,11,11,4" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="96" MaxHeight="260" VerticalScrollBarVisibility="Auto" TextChanged="Task_TextChanged"
                                     GotKeyboardFocus="Task_Focus" LostKeyboardFocus="Task_Focus"/>
                            <TextBlock x:Name="TaskPlaceholder" Margin="15,12,13,0" IsHitTestVisible="False" FontSize="13.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                       Text="What should the agent do? e.g. Make the login page remember the last email"/>
                        </Grid>
                        <TextBlock Text="The agent sees this task and the repo, nothing else." FontSize="11.5" Foreground="{StaticResource Faint}" Margin="13,2,13,9"/>
                    </StackPanel>
                </Border>

                <!-- Agent -->
                <TextBlock Text="Agent" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,18,0,7"/>
                <ItemsControl x:Name="AgentGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource AgentCard}" GroupName="agent" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="Agent_Checked">
                                <StackPanel>
                                    <Border x:Name="Mono" Width="30" Height="30" CornerRadius="8" Background="{StaticResource Bg3}" HorizontalAlignment="Left">
                                        <TextBlock x:Name="MonoText" Text="{Binding Mono}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource FgStrong}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Mono" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="MonoText" Property="Foreground" Value="{StaticResource OnAccent}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Missing}" Value="True">
                                    <Setter TargetName="Mono" Property="Opacity" Value="0.55"/>
                                    <Setter TargetName="NameText" Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="CustomBox" Style="{StaticResource FieldBox}" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                         Tag="my-agent --prompt  (the task is in $BELLBOARD_AGENT_TASK)" Visibility="Collapsed" TextChanged="Custom_TextChanged"/>

                <!-- Branches -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Base branch" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                        <TextBox x:Name="BaseBox" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Tag="current branch" TextChanged="Plan_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Right" Text="auto from task" FontSize="11.5" Foreground="{StaticResource Faint}"/>
                            <TextBlock Text="New branch" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                        <TextBox x:Name="BranchBox" Style="{StaticResource FieldBox}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Tag="bellboard/…" TextChanged="Branch_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- What happens when you start -->
                <Border Margin="0,18,0,0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <Button Style="{StaticResource SidebarButton}" Padding="0" Click="PlanToggle_Click" Margin="2,2,2,0">
                            <DockPanel>
                                <TextBlock x:Name="PlanChevron" DockPanel.Dock="Right" Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="What happens when you start" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>
                        <TextBlock x:Name="PlanText" FontFamily="{StaticResource MonoFont}" FontSize="12" LineHeight="21" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="13,2,13,10"/>
                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="13,9">
                            <DockPanel>
                                <TextBlock x:Name="NoteGlyph" DockPanel.Dock="Left" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top" Margin="0,1,8,0"/>
                                <TextBlock x:Name="NoteText" FontSize="11.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" LineHeight="17"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
