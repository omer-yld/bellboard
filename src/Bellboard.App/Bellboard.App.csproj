<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target for WinRT toast notifications (Windows 10 1809+). -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Bellboard</AssemblyName>
    <AssemblyTitle>Bellboard</AssemblyTitle>
    <RootNamespace>Bellboard</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>bellboard.ico</ApplicationIcon>
    <!-- The ConPTY package's .props reads PlatformTarget before the RID sets it; ship x64 + arm64 OpenConsole explicitly. -->
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 hosts the GPU (WebGL) terminal renderer and the in-app browser. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Microsoft's redistributable ConPTY (conpty.dll + OpenConsole.exe), newer than the inbox one. -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
    <!-- Toasts with buttons for unpackaged desktop apps. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bellboard.Tests" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="bellboard.ico" />
    <!-- Geist and JetBrains Mono (SIL Open Font License; the license texts ship next to the app). -->
    <Resource Include="fonts\*.ttf" />
    <!-- `bell` for WSL shells: a POSIX script that runs bell.exe (on PATH in every pane, after bell.exe's own folder). -->
    <Content Include="wsl\bell" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
